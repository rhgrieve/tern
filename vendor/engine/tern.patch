+        let found: i64 = connection.pragma_query_value(None, "user_version", |row| row.get(0))?;
+        let supported = migrations::latest_version();
+        if found != supported {
+            return Err(Error::SchemaTooNew { found, supported });
+        }
+        Ok(Store {
+            connection: Mutex::new(connection),
+        })
